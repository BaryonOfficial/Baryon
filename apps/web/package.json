{
  "name": "@baryon/web",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:https": "cross-env HTTPS=true vite",
    "build": "vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "test:unit": "node --test tests/unit/**/*.test.js",
    "typecheck": "tsc -p tsconfig.json",
    "preview": "vite preview",
    "test:smoke": "pnpm test:smoke:prod",
    "test:smoke:dev": "playwright test tests/controls.smoke.spec.js",
    "test:smoke:prod": "playwright test -c playwright.prod.config.js tests/production.smoke.spec.js"
  },
  "dependencies": {
    "@baryon/app-shell": "workspace:*",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@baryon/config": "workspace:*",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-basic-ssl": "^2.2.0",
    "cross-env": "^10.1.0",
    "tailwindcss": "^4.2.1",
    "vite": "^7.3.1"
  }
}
