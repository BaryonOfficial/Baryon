{
  "name": "baryon-monorepo",
  "private": true,
  "version": "1.0.0",
  "license": "LicenseRef-PolyForm-Strict-1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BaryonOfficial/Baryon.git"
  },
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "turbo dev --filter=@baryon/web",
    "dev:desktop:packaged": "pnpm --filter @baryon/desktop acceptance:prepare && pnpm --filter @baryon/desktop run:packaged",
    "dev:marketing": "turbo dev --filter=@baryon/marketing",
    "dev:desktop:probe": "BARYON_DEV_PERF_PROBE=1 pnpm --filter @baryon/desktop dev",
    "build": "turbo build",
    "build:web": "turbo build --filter=@baryon/web",
    "build:marketing": "turbo build --filter=@baryon/marketing",
    "preflight:public": "bash scripts/preflight-public.sh",
    "preflight:web:vercel": "bash scripts/preflight-web-vercel.sh",
    "repo:map": "node scripts/generate-repo-map.mjs",
    "repo:map:check": "node scripts/generate-repo-map.mjs --check",
    "docs:check": "node scripts/check-docs.mjs",
    "version:check": "node scripts/workspace-version.mjs --check",
    "version:set": "node scripts/workspace-version.mjs",
    "release:patch": "node scripts/release-bump.mjs patch",
    "release:minor": "node scripts/release-bump.mjs minor",
    "release:major": "node scripts/release-bump.mjs major",
    "release:build": "node scripts/release-build.mjs",
    "nav": "node scripts/repo-nav.mjs",
    "ast": "node scripts/ast-grep.mjs",
    "xref": "node scripts/semantic-xref.mjs",
    "rename": "node scripts/semantic-rename.mjs",
    "dead-exports": "node scripts/dead-exports.mjs",
    "shape": "node scripts/shape-trace.mjs",
    "contract:desktop-bridge": "node scripts/contract-desktop-bridge.mjs",
    "contract:render-authority": "node scripts/check-render-authority-contract.mjs",
    "deps:versions": "syncpack lint --dependency-types prod,dev,peer",
    "deps:versions:fix": "syncpack fix --dependency-types prod,dev,peer",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:app-shell": "pnpm --filter @baryon/app-shell test",
    "test:desktop": "pnpm --filter @baryon/desktop test",
    "test:desktop:platform": "pnpm --filter @baryon/desktop test:platform",
    "test:desktop:native:verify": "pnpm --filter @baryon/desktop test:native:verify",
    "test:lumen": "pnpm --filter @baryon/lumen test",
    "test:marketing": "pnpm --filter @baryon/marketing test",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:visualizer": "pnpm --filter @baryon/visualizer test",
    "test:web:unit": "pnpm --filter @baryon/web test:unit",
    "test:deterministic": "pnpm test:scripts && pnpm test:visualizer && pnpm test:app-shell && pnpm test:desktop && pnpm test:desktop:platform && pnpm test:web:unit && pnpm test:marketing && pnpm test:lumen",
    "perf:web:baseline": "pnpm --filter @baryon/web perf:baseline",
    "acceptance:web": "pnpm --filter @baryon/web acceptance:prod",
    "acceptance:web:dev": "pnpm --filter @baryon/web acceptance:dev",
    "acceptance:desktop": "pnpm --filter @baryon/desktop acceptance:shell",
    "acceptance:desktop:native": "pnpm --filter @baryon/desktop acceptance:native-output",
    "acceptance:marketing": "pnpm --filter @baryon/marketing acceptance",
    "lint": "turbo lint",
    "lint:all": "pnpm -r --filter './apps/*' --filter './packages/*' --if-present lint",
    "lint:deps": "depcruise --config .dependency-cruiser.cjs apps packages",
    "lint:deps:graph": "depcruise --config .dependency-cruiser.cjs --output-type dot --output-to dependency-graph.dot apps packages",
    "deps:graph:dot": "node scripts/render-dependency-graph.mjs",
    "deps:graph:svg": "node scripts/render-dependency-graph.mjs --svg",
    "audit:deps": "knip --dependencies",
    "audit:dead": "knip",
    "audit:dead:deps": "knip --dependencies",
    "audit:dead:exports": "node scripts/audit-dead-exports.mjs",
    "typecheck": "pnpm --reporter append-only -r --filter './apps/*' --filter './packages/*' --if-present typecheck",
    "verify": "pnpm version:check && pnpm docs:check && pnpm contract:render-authority && pnpm deps:versions && pnpm lint:deps && pnpm lint:all && pnpm typecheck && pnpm build:marketing && pnpm test:deterministic",
    "postverify": "node scripts/record-verify-success.mjs",
    "verify:cache:check": "node scripts/check-verify-cache.mjs",
    "verify:acceptance": "pnpm verify && pnpm acceptance:web && pnpm acceptance:marketing && pnpm acceptance:desktop && pnpm test:desktop:native:verify",
    "verify:full": "pnpm verify:acceptance && turbo build"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{ts,tsx,cjs,mjs,json,md,css,scss,html,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.42.0",
    "@eslint/js": "^9.39.4",
    "dependency-cruiser": "^17.3.10",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "knip": "^6.3.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "0.14.1",
    "syncpack": "^14.3.0",
    "turbo": "^2.9.3",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "pnpm": {
    "overrides": {
      "@baryon/marketing>vite": "7.3.1"
    },
    "onlyBuiltDependencies": [
      "@baryon/lumen",
      "@swc/core",
      "electron",
      "esbuild",
      "fs-xattr",
      "macos-alias",
      "protobufjs"
    ]
  }
}
