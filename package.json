{
  "name": "baryon-monorepo",
  "private": true,
  "version": "0.0.0",
  "license": "LicenseRef-ELv2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BaryonOfficial/Baryon.git"
  },
  "scripts": {
    "dev": "turbo dev --filter=@baryon/web",
    "build": "turbo build",
    "build:web": "turbo build --filter=@baryon/web",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:visualizer": "pnpm --filter @baryon/visualizer test",
    "test:web-smoke": "pnpm --filter @baryon/web test:smoke",
    "test:web-smoke:dev": "pnpm --filter @baryon/web test:smoke:dev",
    "lint": "turbo lint",
    "lint:all": "pnpm -r --filter './apps/*' --filter './packages/*' --if-present lint",
    "audit:deps": "knip --dependencies --isolate-workspaces",
    "typecheck": "pnpm --reporter append-only -r --filter './apps/*' --filter './packages/*' --if-present typecheck",
    "verify": "pnpm lint:all && pnpm typecheck && pnpm test:visualizer",
    "verify:full": "pnpm verify && turbo build"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{ts,tsx,cjs,mjs,json,md,css,scss,html,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "knip": "^5.86.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "turbo": "^2.8.17",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.12.4"
}
