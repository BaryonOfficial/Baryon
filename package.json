{
  "name": "baryon-monorepo",
  "private": true,
  "version": "1.4.1",
  "license": "LicenseRef-PolyForm-Strict-1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BaryonOfficial/Baryon.git"
  },
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "turbo dev --filter=@baryon/web",
    "dev:docs": "pnpm --dir docs dev",
    "build": "turbo build",
    "build:web": "turbo build --filter=@baryon/web",
    "docs:check": "node scripts/check-docs.mjs",
    "docs:mintlify:check": "pnpm --dir docs mintlify:check",
    "version:check": "node scripts/workspace-version.mjs --check",
    "version:set": "node scripts/workspace-version.mjs",
    "deps:versions": "syncpack lint --dependency-types prod,dev,peer",
    "deps:versions:fix": "syncpack fix --dependency-types prod,dev,peer",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:config": "pnpm --filter @baryon/config test",
    "test:app-shell": "pnpm --filter @baryon/app-shell test",
    "test:engine": "pnpm --filter @baryon/engine test",
    "test:web:unit": "pnpm --filter @baryon/web test:unit",
    "perf:web:baseline": "pnpm --filter @baryon/web perf:baseline",
    "acceptance:web": "pnpm --filter @baryon/web acceptance:prod",
    "acceptance:web:engine": "pnpm --filter @baryon/web acceptance:engine-webgpu",
    "acceptance:web:dev": "pnpm --filter @baryon/web acceptance:dev",
    "lint": "turbo lint",
    "lint:all": "pnpm -r --filter \"./apps/*\" --filter \"./packages/*\" --if-present lint",
    "lint:deps": "depcruise --config .dependency-cruiser.cjs apps packages",
    "lint:deps:graph": "depcruise --config .dependency-cruiser.cjs --output-type dot --output-to dependency-graph.dot apps packages",
    "audit:deps": "knip --dependencies",
    "audit:dead": "knip",
    "audit:dead:production": "knip --production --include files,exports --no-exit-code",
    "audit:dead:deps": "knip --dependencies",
    "typecheck": "pnpm --reporter append-only -r --filter \"./apps/*\" --filter \"./packages/*\" --if-present typecheck",
    "test:deterministic": "pnpm test:engine && pnpm test:app-shell && pnpm test:web:unit",
    "verify": "pnpm version:check && pnpm docs:check && pnpm deps:versions && pnpm lint:deps && pnpm audit:dead && pnpm lint:all && pnpm typecheck && pnpm test:deterministic",
    "verify:acceptance": "pnpm verify && pnpm acceptance:web",
    "verify:full": "pnpm verify:acceptance && turbo build"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{ts,tsx,cjs,mjs,json,md,css,scss,html,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "dependency-cruiser": "^17.3.10",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "knip": "^6.3.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "0.14.1",
    "syncpack": "^14.3.0",
    "turbo": "^2.9.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.1"
  },
  "packageManager": "pnpm@11.9.0+sha256.2b567aa66026238078ac2e0a33bec3febd60e962987aac697456f3180819b287"
}
