{
  "name": "baryon-monorepo",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "turbo dev --filter=@baryon/web",
    "dev:desktop": "turbo dev --filter=@baryon/desktop",
    "build": "turbo build",
    "build:web": "turbo build --filter=@baryon/web",
    "test:visualizer": "pnpm --filter @baryon/visualizer test",
    "test:web-smoke": "pnpm --filter @baryon/web test:smoke",
    "lint": "turbo lint",
    "lint:all": "pnpm -r --filter './apps/*' --filter './packages/*' --if-present lint",
    "typecheck": "pnpm -r --filter './apps/*' --filter './packages/*' --if-present typecheck",
    "verify": "pnpm lint:all && pnpm typecheck && turbo build"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "eslint": "^9.27.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "typescript": "^5.8.3",
    "turbo": "^2.3.0"
  },
  "packageManager": "pnpm@10.12.4"
}
